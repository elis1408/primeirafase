programa {
  funcao inicio() {
    cadeia diaDaSemana
    escreva("escolha um dia da semana: ")
    leia (diaDaSemana)
    se (diaDaSemana== "segunda-feira"){
    escreva(" o seu número do dia é 2")
    }
    se (diaDaSemana== "domingo"){
    escreva(" o seu número do dia é 1")
    }
    se (diaDaSemana== "treça-feira"){
    escreva(" o seu número do dia é 3")
    }
    se (diaDaSemana== "quarta-feira"){
    escreva(" o seu número do dia é 4")
    }
    se (diaDaSemana== "quinta-feira"){
    escreva(" o seu número do dia é 5")
    }
    se (diaDaSemana== "sexta-feira"){
    escreva(" o seu número do dia é 6")
    }
    se (diaDaSemana== "sabádo"){
    escreva(" o seu número do dia é 7")
    }
    


  }
}
