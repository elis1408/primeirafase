programa {
  funcao inicio() {
    inteiro quantidade1 ,quantidade2 ,valorFinal
    escreva("qual è a sua quantidade inicial de laranjas?: ")
    leia(quantidade1)
    escreva("qual è a sua quantidade final de laranjas?: ")
    leia(quantidade2)
    valorFinal = quantidade1-quantidade2
    escreva("sua quantidade de laranja  final é " + valorFinal)
  }
}
