programa {
  funcao inicio() {
    inteiro pesoDoCaminhao
    inteiro taraDoCaminhao
    inteiro total
    inteiro resultado
    escreva ("qual é o peso do caminhão? ")
    leia (pesoDoCaminhao)
    escreva ("qual é a tara do caminhão? ")
    leia (taraDoCaminhao)
    total = pesoDoCaminhao - taraDoCaminhao
    resultado = total 
    escreva ("a carga total do caminhão é de: ")
    escreva (total)



  }
}
